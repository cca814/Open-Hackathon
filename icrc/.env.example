# Run on the DPU. Fill in verified values; no PCI or CPU mapping is assumed.
RX_PCI=
TX_PCI=
# Nine available cores: one main + eight workers, e.g. 0-8 if available.
LCORES=
# Point to your real receiver config. The checked-in file is only an example.
GROUPS_FILE=./config/groups.example.json
# Must already be a mounted hugetlbfs with enough allocated/free hugepages.
HUGEPAGES_DIR=/dev/hugepages
# Optional: pin a matching NGC image digest once the SDK build is verified.
DOCA_IMAGE=nvcr.io/nvidia/doca/doca:devel-3.5.0
